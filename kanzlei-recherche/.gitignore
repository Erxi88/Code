# Laufzeitdaten (Datenbank, Exporte, Logs)
data/*
!data/.gitkeep
*.sqlite
*.sqlite3
*.db
*.xlsx
!tests/fixtures/**/*.xlsx
~$*.xlsx

# Geheimnisse
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editoren / OS
.idea/
.vscode/
.DS_Store

# Echte Kanzleiseiten (personenbezogene Daten) nur lokal
tests/fixtures/kanzleiseiten/echt/*
!tests/fixtures/kanzleiseiten/echt/.gitkeep
