# API-Schlüssel der Discovery-Quellen. Kopieren nach .env und ausfüllen – .env wird nie committet.
# ddgs (nur Entwicklung) braucht keinen Key.

# Stufe A (Standard): Brave Search API
BRAVE_API_KEY=

# Stufe A optional: Google Custom Search JSON API (nur mit Alt-Key; Ende 01.01.2027)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Stufe A optional (Pilot-Vergleich): SerpAPI
SERPAPI_KEY=

# Stufe B: Google Places API (New)
GOOGLE_PLACES_API_KEY=
